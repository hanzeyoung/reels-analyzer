# =============================================
# .env.example — 실제 키 넣고 파일명을 .env 로 바꾸세요
# 이 파일은 GitHub에 올려도 됩니다 (키 값 없음)
# =============================================

# Meta Graph API (인스타그램 데이터 수집)
META_ACCESS_TOKEN=your_meta_access_token_here
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_GRAPH_API_VERSION=v24.0
META_REDIRECT_URI=http://127.0.0.1:8501
META_TOKEN_ENCRYPTION_KEY=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
APP_ENV=development
APP_RELEASE=
META_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_insights
META_SYNC_BUSINESS_TYPE=카페
META_SYNC_LIMIT=30

# HTTPS로 배포한 모바일 코치 주소가 있으면 설정하세요.
# 휴대폰 브라우저 카메라는 일반 LAN HTTP에서 차단될 수 있습니다.
MOBILE_COACH_BASE_URL=
APP_BASE_URL=

# 주간 경쟁 추적 알림. Slack/Discord/custom webhook 등 JSON POST를 받는 주소를 사용합니다.
MARKET_ALERT_WEBHOOK_URL=
MARKET_ALERT_MIN_VIEWS=10000

# Google Gemini API (멀티모달 영상 분석)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_CALL_LIMIT=100
APIFY_DAILY_CALL_LIMIT=50

# Supabase (DB)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
REQUIRE_APP_LOGIN=false

# Flux 1.1 Pro - BFL API (가이드 이미지 생성)
BFL_API_KEY=your_bfl_api_key_here
BFL_FLUX_ENDPOINT=https://api.bfl.ai/v1/flux-pro-1.1

# ElevenLabs (AI 음성 나레이션, 선택)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
ELEVENLABS_MODEL=eleven_multilingual_v2

# OpenAI GPT-4o (NLP 보조 분석, 선택)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API (보고서 작성)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-4-5
