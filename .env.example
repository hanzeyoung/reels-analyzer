# Postgres (로컬 또는 Supabase).
#
# Supabase는 Session pooler를 쓴다:
#   postgres://user:pass@aws-<region>.pooler.supabase.com:5432/postgres
# Direct connection(db.*.supabase.co:5432)은 IPv6 전용이라 IPv6 아웃바운드가 없는 환경에서
# 접속이 안 된다 (G0 A-4, 2026-08-07 수정). Session pooler는 IPv4로 붙고 prepared statement도
# 지원한다. Transaction pooler(포트 6543)는 절대 쓰지 마라 — 워커는 연결을 오래 들고 있는
# 상시 프로세스라 그 모드와 안 맞고, 세션 간 prepared statement도 못 쓴다.
DATABASE_URL=

# 외부 의존 모드 스위치. 기본은 전부 fake.
APIFY_MODE=fake
VISION_MODE=fake
WRITER_MODE=fake

APIFY_TOKEN=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# stale 복구 임계값 (분)
STALE_MINUTES=5

# fake provider가 읽는 fixtures 위치. 기본값(주석 처리 유지)은 프로젝트 루트의 fixtures/
# 절대경로다. 다른 위치를 쓸 때만 주석 해제해서 값을 채운다 — 빈 문자열로 두면 기본값을
# 덮어써서 깨진다.
# FIXTURES_DIR=
