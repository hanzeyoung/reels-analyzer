# =============================================
# .env.example — 실제 키 넣고 파일명을 .env 로 바꾸세요
# 이 파일은 GitHub에 올려도 됩니다 (키 값 없음)
# =============================================

# Meta Graph API (인스타그램 데이터 수집)
META_ACCESS_TOKEN=your_meta_access_token_here
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# Google Gemini API (멀티모달 영상 분석)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (DB)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Flux 1.1 Pro - BFL API (가이드 이미지 생성)
BFL_API_KEY=your_bfl_api_key_here

# ElevenLabs (AI 음성 나레이션, 선택)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenAI GPT-4o (NLP 보조 분석, 선택)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API (보고서 작성)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
